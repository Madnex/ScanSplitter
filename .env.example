# Copy this file to .env and replace the placeholder key.
# The real .env is ignored by git.
OPENROUTER_API_KEY=sk-or-v1-replace-me
OPENROUTER_MODEL=google/gemini-3.7-flash
# Successful LLM responses are cached locally by default to avoid repeat charges.
# SCANSPLITTER_LLM_CACHE=0
# SCANSPLITTER_LLM_CACHE_DIR=/path/to/cache
SCANSPLITTER_BENCHMARK=1
